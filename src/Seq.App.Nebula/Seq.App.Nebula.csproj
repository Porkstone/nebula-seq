<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Seq.App.Nebula</PackageId>
    <Authors>Nebula</Authors>
    <Description>Turn Seq errors into deduplicated Jira bugs using Codex CLI through OpenRouter.</Description>
    <PackageTags>seq-app;seq;jira;openrouter;codex</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Porkstone/nebula-seq</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Porkstone/nebula-seq</PackageProjectUrl>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- Seq requires bundled files and supplies Seq.Apps/Serilog itself; no NuGet dependency group is intentional. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Seq.Apps" Version="2023.4.0" PrivateAssets="all" />
    <ProjectReference Include="../Nebula.Seq.Core/Nebula.Seq.Core.csproj" />
    <ProjectReference Include="../Nebula.Seq.JiraMcp/Nebula.Seq.JiraMcp.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Target Name="BundleRuntime" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="$(TargetDir)Nebula.Seq.Core.dll" Pack="true" PackagePath="lib/$(TargetFramework)" />
      <None Include="../Nebula.Seq.JiraMcp/bin/$(Configuration)/$(TargetFramework)/Nebula.Seq.JiraMcp.dll;../Nebula.Seq.JiraMcp/bin/$(Configuration)/$(TargetFramework)/Nebula.Seq.JiraMcp.deps.json;../Nebula.Seq.JiraMcp/bin/$(Configuration)/$(TargetFramework)/Nebula.Seq.JiraMcp.runtimeconfig.json" Pack="true" PackagePath="lib/$(TargetFramework)" />
    </ItemGroup>
  </Target>
</Project>
